<!DOCTYPE html>
<html>

<head>
    <title>Docker Task Manager</title>
    <link rel="stylesheet" href="style.css">
</head>
<script src="app.js"></script>
<body>

<div class="container">

    <h1>📋 Task Manager</h1>

    <div class="input-area">

        <input
            id="taskInput"
            type="text"
            placeholder="Enter a task"
        >

        <button onclick="addTask()">
            Add
        </button>

    </div>

    <div id="taskList"></div>

</div>

<script src="app.js"></script>

</body>

</html>